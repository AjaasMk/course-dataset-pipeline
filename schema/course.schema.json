{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-portal.local/schema/course.schema.json",
  "title": "CourseDetailPage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "course_id",
    "slug",
    "course_name",
    "course_level",
    "category",
    "subcategory",
    "currency",
    "region",
    "seo",
    "hero",
    "quick_facts",
    "snapshot",
    "overview",
    "suitability",
    "eligibility",
    "curriculum",
    "skills",
    "careers",
    "recruiters",
    "further_study_pathway",
    "fees",
    "colleges",
    "comparison",
    "action_roadmap",
    "parent_corner",
    "faqs",
    "verification"
  ],
  "properties": {
    "course_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Stable identifier supplied by the pipeline, not generated by the model."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "course_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90,
      "description": "Hero H1. Example: 'BSc Psychology'."
    },
    "course_level": {
      "type": "string",
      "enum": [
        "Undergraduate",
        "Postgraduate",
        "Diploma",
        "Certificate",
        "Doctoral"
      ],
      "description": "First hero eyebrow chip."
    },
    "category": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60,
      "description": "Breadcrumb level 3 and second hero eyebrow chip. Example: 'Health & Behavioural Sciences'."
    },
    "subcategory": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "Breadcrumb leaf. Example: 'Psychology'."
    },
    "currency": {
      "type": "string",
      "enum": [
        "INR",
        "USD",
        "GBP",
        "EUR",
        "AED"
      ],
      "description": "Applies to every integer money field in this document."
    },
    "region": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "Country or region all figures are scoped to. Example: 'India'."
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_title",
        "meta_description"
      ],
      "properties": {
        "page_title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 70
        },
        "meta_description": {
          "type": "string",
          "minLength": 50,
          "maxLength": 160
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge",
        "summary",
        "fit"
      ],
      "properties": {
        "badge": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "description": "Third hero eyebrow chip. Example: 'Student-friendly guide'."
        },
        "summary": {
          "type": "string",
          "minLength": 150,
          "maxLength": 420,
          "description": "Hero paragraph, 2-3 sentences."
        },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score_percent",
            "note",
            "indicators"
          ],
          "properties": {
            "score_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "note": {
              "type": "string",
              "minLength": 20,
              "maxLength": 120
            },
            "indicators": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 10,
                "maxLength": 70
              }
            }
          }
        }
      }
    },
    "quick_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typical_duration",
        "entry_level",
        "suitable_streams",
        "learning_style",
        "indicative_annual_fees",
        "career_direction"
      ],
      "properties": {
        "typical_duration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_years",
            "max_years"
          ],
          "properties": {
            "min_years": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 10
            },
            "max_years": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 10
            }
          }
        },
        "entry_level": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "description": "Example: 'Class 12'."
        },
        "suitable_streams": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          }
        },
        "learning_style": {
          "type": "string",
          "minLength": 10,
          "maxLength": 60
        },
        "indicative_annual_fees": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "description": "Tuition per year for the mainstream middle of the market, not the absolute cheapest government seat against the most expensive private one.",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000000
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50000000
            }
          }
        },
        "career_direction": {
          "type": "string",
          "minLength": 10,
          "maxLength": 70
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salary",
        "specialisations",
        "data_note"
      ],
      "properties": {
        "salary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower_annual",
            "typical_annual",
            "higher_annual",
            "higher_is_open_ended",
            "marker_percent",
            "note"
          ],
          "properties": {
            "lower_annual": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "typical_annual": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "higher_annual": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000000
            },
            "higher_is_open_ended": {
              "type": "boolean",
              "description": "True renders the '+' suffix, as in the demo's '8 LPA+'."
            },
            "marker_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Position of the typical-salary dot on the scale bar."
            },
            "note": {
              "type": "string",
              "minLength": 60,
              "maxLength": 320
            }
          }
        },
        "specialisations": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 45
          }
        },
        "data_note": {
          "type": "string",
          "minLength": 60,
          "maxLength": 320
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "paragraphs"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80,
          "description": "Example: 'What is BSc Psychology?'."
        },
        "paragraphs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 120,
            "maxLength": 600
          },
          "description": "Combined target ~180 words."
        }
      }
    },
    "suitability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "good_fit",
        "caution",
        "tags"
      ],
      "properties": {
        "good_fit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "points"
          ],
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 10,
              "maxLength": 70
            },
            "points": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 20,
                "maxLength": 140
              }
            }
          }
        },
        "caution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "points"
          ],
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 10,
              "maxLength": 70
            },
            "points": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 20,
                "maxLength": 140
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          }
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typical_requirements",
        "admission_methods",
        "admission_timeline"
      ],
      "properties": {
        "typical_requirements": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 20,
            "maxLength": 140
          }
        },
        "admission_methods": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 140
          }
        },
        "admission_timeline": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "title",
              "description"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "title": {
                "type": "string",
                "minLength": 5,
                "maxLength": 40
              },
              "description": {
                "type": "string",
                "minLength": 20,
                "maxLength": 120
              }
            }
          }
        }
      }
    },
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "years",
        "learning_activities",
        "assessment_methods"
      ],
      "properties": {
        "years": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "description": "One entry per academic year the course actually runs. The count must equal the upper bound of typical_duration, so a two-year course has two entries and a five-year course five. curriculum_length_matches_duration enforces it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "label",
              "subjects"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "label": {
                "type": "string",
                "minLength": 4,
                "maxLength": 20
              },
              "subjects": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "description"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 4,
                      "maxLength": 60
                    },
                    "description": {
                      "type": "string",
                      "minLength": 20,
                      "maxLength": 120
                    }
                  }
                }
              }
            }
          }
        },
        "learning_activities": {
          "type": "string",
          "minLength": 60,
          "maxLength": 300
        },
        "assessment_methods": {
          "type": "string",
          "minLength": 60,
          "maxLength": 300
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 4,
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 120
          }
        }
      }
    },
    "careers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "route_badge",
          "typical_route"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 4,
            "maxLength": 50
          },
          "description": {
            "type": "string",
            "minLength": 30,
            "maxLength": 160
          },
          "route_badge": {
            "type": "string",
            "enum": [
              "Possible after bachelor's",
              "Training may be required",
              "Postgraduate route",
              "Advanced regulated route",
              "Higher study required"
            ]
          },
          "typical_route": {
            "type": "string",
            "minLength": 15,
            "maxLength": 110,
            "description": "Arrow-separated path. Example: 'BSc Psychology -> Research experience'."
          }
        }
      }
    },
    "recruiters": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logo_initials",
          "name",
          "sector",
          "description",
          "roles"
        ],
        "properties": {
          "logo_initials": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "sector": {
            "type": "string",
            "minLength": 5,
            "maxLength": 45
          },
          "description": {
            "type": "string",
            "minLength": 40,
            "maxLength": 180
          },
          "roles": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 30
            }
          }
        }
      }
    },
    "further_study_pathway": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 35
      }
    },
    "fees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "footnote"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "description": "The four demo categories at minimum. Split tuition into one row per institution type whenever government and private costs differ by more than an order of magnitude.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "min",
              "max",
              "is_variable",
              "frequency",
              "parent_check"
            ],
            "properties": {
              "category": {
                "type": "string",
                "minLength": 4,
                "maxLength": 40
              },
              "institution_type": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "government",
                  "government_aided",
                  "private",
                  "premier_national",
                  null
                ],
                "description": "Which institutions this row's range describes. Null means it applies to all of them."
              },
              "min": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 50000000
              },
              "max": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 50000000
              },
              "is_variable": {
                "type": "boolean",
                "description": "True renders 'Varies'. Leave min and max null, or give both to show a typical range alongside it. Never give only one of the two."
              },
              "frequency": {
                "type": "string",
                "enum": [
                  "Per year",
                  "Per semester",
                  "One time",
                  "Total programme",
                  "As required"
                ]
              },
              "parent_check": {
                "type": "string",
                "minLength": 15,
                "maxLength": 120
              }
            }
          }
        },
        "footnote": {
          "type": "string",
          "minLength": 40,
          "maxLength": 220
        }
      }
    },
    "colleges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranking_source",
        "ranking_updated",
        "items",
        "data_note"
      ],
      "properties": {
        "ranking_source": {
          "type": "string",
          "minLength": 5,
          "maxLength": 80
        },
        "ranking_updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "description": "YYYY-MM."
        },
        "items": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank",
              "name",
              "city",
              "course_name",
              "duration_years",
              "institution_type",
              "admission_route",
              "highlight",
              "annual_fee"
            ],
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "name": {
                "type": "string",
                "minLength": 5,
                "maxLength": 90
              },
              "city": {
                "type": "string",
                "minLength": 3,
                "maxLength": 40
              },
              "course_name": {
                "type": "string",
                "minLength": 3,
                "maxLength": 60
              },
              "duration_years": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 10
              },
              "institution_type": {
                "type": "string",
                "enum": [
                  "government",
                  "private"
                ]
              },
              "admission_route": {
                "type": "string",
                "minLength": 4,
                "maxLength": 40
              },
              "highlight": {
                "type": "string",
                "minLength": 4,
                "maxLength": 40
              },
              "annual_fee": {
                "type": "integer",
                "minimum": 0,
                "maximum": 50000000
              }
            }
          }
        },
        "data_note": {
          "type": "string",
          "minLength": 60,
          "maxLength": 400
        }
      }
    },
    "comparison": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "description": "First entry must be this course. The four properties are the demo's four fixed comparison rows.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "course_name",
          "main_focus",
          "statistics_level",
          "laboratory_exposure",
          "common_next_steps"
        ],
        "properties": {
          "course_name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60
          },
          "main_focus": {
            "type": "string",
            "minLength": 10,
            "maxLength": 80
          },
          "statistics_level": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "laboratory_exposure": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "common_next_steps": {
            "type": "string",
            "minLength": 10,
            "maxLength": 80
          }
        }
      }
    },
    "action_roadmap": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "title",
          "description"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "Grades 8-10",
              "Grade 11",
              "Grade 12"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          },
          "description": {
            "type": "string",
            "minLength": 40,
            "maxLength": 220
          }
        }
      }
    },
    "parent_corner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro",
        "questions"
      ],
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 620,
          "maxLength": 1400,
          "description": "Target ~150 words; the accepted band is 110-220 words."
        },
        "questions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 20,
            "maxLength": 110
          }
        }
      }
    },
    "faqs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 15,
            "maxLength": 110
          },
          "answer": {
            "type": "string",
            "minLength": 80,
            "maxLength": 420
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_reviewed",
        "sources"
      ],
      "properties": {
        "last_reviewed": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "sources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url",
              "publisher"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 5,
                "maxLength": 140
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "publisher": {
                "type": "string",
                "minLength": 2,
                "maxLength": 80
              }
            }
          }
        }
      }
    }
  }
}
