PERPLEXITY_API_KEY=
PERPLEXITY_PRESET=fast
PERPLEXITY_MODEL=
MAX_OUTPUT_TOKENS=8000
PERPLEXITY_BASE_URL=https://api.perplexity.ai

SEARCH_DOMAINS=
SEARCH_RECENCY=year
DOMAINS_PATH=config/domains.json
ALLOW_UNKNOWN_DISCIPLINE=false
INCLUDE_SCHEMA_IN_PROMPT=false

REGION=India
CURRENCY=INR

REQUEST_TIMEOUT_SECONDS=120
REQUEST_INTERVAL_SECONDS=2
TRANSPORT_MAX_RETRIES=4
TRANSPORT_BACKOFF_BASE_SECONDS=2
TRANSPORT_BACKOFF_MAX_SECONDS=60
GENERATION_MAX_ATTEMPTS=3

SCHEMA_PATH=schema/course.schema.json
ARTIFACTS_DIR=artifacts
REVIEW_DIR=artifacts/_review

LARAVEL_ENDPOINT=
LARAVEL_API_TOKEN=
LARAVEL_METHOD=POST
LARAVEL_PAYLOAD_KEY=
LARAVEL_AUTH_HEADER=Authorization
LARAVEL_AUTH_SCHEME=Bearer
