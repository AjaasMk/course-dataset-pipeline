      { "section": "overview", "declared": "About 180 words", "measured_words": 109 },
      { "section": "skills_you_can_develop", "declared": "9 skill areas", "measured_items": 6 },
      { "section": "frequently_asked_questions", "declared": "6-10 questions", "measured_items": 5 },
      { "section": "parent_corner", "declared": "About 150 words", "measured_words": 35 }
    ]
  },
