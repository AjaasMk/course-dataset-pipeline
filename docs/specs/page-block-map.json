{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course page block map — binding between the client's rendered page and our producers",
  "description": "The client's demo template is the authoritative page structure. This file binds each rendered block to whatever produces its content, so a block with no producer and a producer with no block are both visible failures rather than silent ones. Block order, headings and item counts are measured from the template, not chosen here. Validated by scripts/check_page_coverage.py.",
  "x-source-template": "docs/specs by fmc/course-details-demo-template-v2.html",
  "x-derived": "2026-08-11",
  "producer_kinds": {
    "retrieval": "Atomic facts from a RETRIEVAL_SEGMENT, extracted with a quoted citation (Hard Constraint 2).",
    "explanatory": "Prose from an EXPLANATORY_SEGMENT — no atomic field, written from retrieved chunks.",
    "derived": "Computed from facts already held for this or another course. No new retrieval, no generation.",
    "advisory": "Guidance content with no atomic fact anywhere in the source directory. LLM-written, no citation possible, provenance=generated.",
    "ui": "Chrome. No course data."
  },
  "blocks": [
    {
      "order": 0,
      "block": "breadcrumbs",
      "heading": null,
      "producer": "derived",
      "segments": [
        "Course Identity"
      ],
      "shape": {
        "path_depth": 4
      }
    },
    {
      "order": 1,
      "block": "hero",
      "heading": null,
